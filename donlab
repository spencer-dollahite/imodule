#!/bin/bash
# DoN Range student launcher (self-contained, self-updating). Distribute via the LMS.
#
# Usage:  donlab <labname> [--no-tmux] [labtainer args...]
#
#   By DEFAULT donlab lays the lab out in a single tmux session -- one WINDOW per
#   host you actually use (hidden/duplicate terminals are skipped), one PANE per
#   terminal that host was given -- and opens the lab manual in Firefox. This works
#   over plain SSH with no pop-up windows to arrange.
#     Ctrl-b n / p  next / previous host      Ctrl-b w   pick a host from a list
#     Ctrl-b % or " split the current host into more panes
#     Ctrl-b d      detach (the lab keeps running; re-attach with: tmux attach -t lab-<lab>)
#   Stop the lab with:  stoplab <lab>
#
#   --no-tmux   use Labtainers' standard pop-up terminals instead of tmux.
#   -v, --version   print the donlab version (and build sha) and exit.
#   -u, --update    force-update donlab itself (cache-busted) and exit.
#   Set DONLAB_NOSELFUPDATE=1 to skip the self-update for one run.
set -uo pipefail
# Release channel. 'prod' (default, what students get) pulls the fully-tested MAIN branch +
# the promoted :latest images; 'dev' pulls the rapid DEV branch + :dev images. Flip to 'dev'
# ONLY on the labtainer VPS / dev box. Persisted across self-updates by the graft below (like
# the key). Override for one run with: DONLAB_CHANNEL=dev donlab <lab>
CHANNEL='prod'   # DONLAB-CHANNEL
CHANNEL="${DONLAB_CHANNEL:-$CHANNEL}"
[ "$CHANNEL" = "dev" ] && DON_BRANCH=dev || DON_BRANCH=main
DON_REPO=spencer-dollahite/imodule
IMODULE_URL=https://raw.githubusercontent.com/$DON_REPO/$DON_BRANCH/imodule.tar.enc
DONLAB_URL=https://raw.githubusercontent.com/$DON_REPO/$DON_BRANCH/donlab

# Launcher version. Bump on donlab changes; travels with the published copy (self-update brings
# the new value -- the graft only preserves the key + channel). The build sha uniquely IDs the copy.
DONLAB_VERSION='1.2.3'
for _a in "$@"; do case "$_a" in
  -v|--version)
    echo "donlab $DONLAB_VERSION (channel: $CHANNEL) build $(sha256sum "${BASH_SOURCE[0]}" 2>/dev/null | cut -c1-12)"
    exit 0 ;;
esac; done
KEYB64=''   # DONLAB-KEY
# dev channel -> pull the rapid :dev images (our framework honors DON_IMAGE_TAG and retags to
# :latest locally). prod leaves it unset -> :latest (the promoted, tested images).
[ "$CHANNEL" = "dev" ] && export DON_IMAGE_TAG=dev

# ---- progress helpers: clear feedback on slow steps; safe/quiet when not a TTY ----
_is_tty() { [ -t 1 ]; }
step() { printf '==> %s\n' "$*"; }
# Run a quiet command with a spinner (on a TTY) or a plain line; show its output only on failure.
run_step() {
  local msg="$1"; shift
  if _is_tty; then
    local log; log="$(mktemp)"; ( "$@" ) >"$log" 2>&1 & local pid=$! s='|/-\\' i=0
    printf '==> %s ' "$msg"
    while kill -0 "$pid" 2>/dev/null; do printf '\b%s' "${s:i++%4:1}"; sleep 0.2; done
    wait "$pid"; local rc=$?; printf '\b%s\n' "$( [ "$rc" -eq 0 ] && printf 'done' || printf 'FAILED' )"
    [ "$rc" -ne 0 ] && sed 's/^/    /' "$log"; rm -f "$log"; return "$rc"
  else
    printf '==> %s\n' "$msg"; "$@"; return $?
  fi
}

# ---- cgroup v2 self-heal (course appliance) ----------------------------------------------
# The stock NPS Labtainers appliance boots the LEGACY cgroup v1 hierarchy. Modern lab
# containers run systemd >= 256 (the Kali red-team host today; Ubuntu 26.04 bases soon), and
# that systemd REFUSES to start under cgroup v1 -- PID 1 exits and the container dies at once.
# cgroup v2 is safe for every current base (Ubuntu 24.04's systemd 255 runs on either). This
# is a course-specific appliance, so donlab just converts it: stage the kernel flag and reboot
# once, no prompt. One-time; a v2 host is a no-op. Opt out for a run with DONLAB_NO_CGROUP_FIX=1.
host_cgroup_v2() { [ "$(stat -fc '%T' /sys/fs/cgroup 2>/dev/null)" = cgroup2fs ]; }
ensure_cgroup2() {
  local m0="${XDG_CONFIG_HOME:-$HOME/.config}/don-range/.cgroup2-reboot"
  if host_cgroup_v2; then rm -f "$m0" 2>/dev/null; return 0; fi
  if [ -n "${DONLAB_NO_CGROUP_FIX:-}" ]; then
    echo "donlab: NOTE this host uses the legacy cgroup v1 layout; modern lab containers"
    echo "        (Kali red-team; Ubuntu 26.04 bases) need cgroup v2 and will not start."
    echo "        Unset DONLAB_NO_CGROUP_FIX to let donlab convert the host automatically."
    return 0
  fi
  local grub=/etc/default/grub SUDO="" marker
  [ "$(id -u)" -eq 0 ] || SUDO="sudo"
  marker="${XDG_CONFIG_HOME:-$HOME/.config}/don-range/.cgroup2-reboot"
  echo "=================================================================="
  echo " donlab: this appliance boots the OLD cgroup v1 layout, which the"
  echo " modern lab containers (e.g. the Kali red-team host) cannot run on."
  echo " Converting it to cgroup v2 -- a ONE-TIME change that needs a reboot."
  echo "=================================================================="
  if [ ! -f "$grub" ]; then
    echo "donlab: no $grub here, so donlab can't auto-convert. Set the kernel argument"
    echo "        systemd.unified_cgroup_hierarchy=1 and reboot, then re-run ./donlab."
    return 0
  fi
  # A v1-PINNED appliance carries systemd.unified_cgroup_hierarchy=0 and/or
  # systemd.legacy_systemd_cgroup_controller=1 on the kernel cmdline (see /proc/cmdline). Those
  # FORCE v1 and override a plain "=1", so we must STRIP them from every place GRUB builds the
  # cmdline: /etc/default/grub AND any /etc/default/grub.d/*.cfg drop-in -- then add =1.
  grub_pins_v1() { grep -qsE 'unified_cgroup_hierarchy=0|legacy_systemd_cgroup_controller=1' "$grub" /etc/default/grub.d/*.cfg 2>/dev/null; }
  grub_ok() { grep -qs 'unified_cgroup_hierarchy=1' "$grub" && ! grub_pins_v1; }
  echo "donlab: /proc/cmdline is:"; sed 's/^/          /' /proc/cmdline 2>/dev/null
  if grub_ok && [ -f "$marker" ]; then
    echo "donlab: GRUB already requests cgroup v2 and pins nothing to v1, yet the running kernel"
    echo "        is still v1 after a reboot. This host may boot a pre-generated grub.cfg or a"
    echo "        different loader. Modern containers won't start until it is v2. Continuing anyway."
    return 0
  fi
  if grub_ok; then
    echo "donlab: cgroup v2 is set but not yet active; rebooting to apply."
  else
    local tmp; tmp="$(mktemp)"
    # normalize /etc/default/grub: strip the cgroup tokens on both CMDLINE vars, add =1 to _DEFAULT
    awk '
      /^GRUB_CMDLINE_LINUX(_DEFAULT)?=/{
        eq=index($0,"="); key=substr($0,1,eq-1); val=substr($0,eq+1); q="";
        if (val ~ /^".*"$/){ q="\""; val=substr(val,2,length(val)-2) }
        gsub(/systemd\.unified_cgroup_hierarchy=[^ ]*/,"",val);
        gsub(/systemd\.legacy_systemd_cgroup_controller=[^ ]*/,"",val);
        gsub(/  +/," ",val); sub(/^ +/,"",val); sub(/ +$/,"",val);
        if (key=="GRUB_CMDLINE_LINUX_DEFAULT") val=(val==""?"":val" ")"systemd.unified_cgroup_hierarchy=1";
        print key"="q val q; next
      }
      {print}
    ' "$grub" > "$tmp" 2>/dev/null
    grep -q 'unified_cgroup_hierarchy=1' "$tmp" || printf 'GRUB_CMDLINE_LINUX_DEFAULT="systemd.unified_cgroup_hierarchy=1"\n' >> "$tmp"
    $SUDO cp "$tmp" "$grub" 2>/dev/null; rm -f "$tmp"
    # strip the v1 pin from any grub.d drop-in (do NOT add =1 there -- the main file carries it)
    for dd in /etc/default/grub.d/*.cfg; do
      [ -f "$dd" ] || continue
      grep -qE 'unified_cgroup_hierarchy=0|legacy_systemd_cgroup_controller=1' "$dd" || continue
      $SUDO sed -i -E 's/systemd\.unified_cgroup_hierarchy=0//g; s/systemd\.legacy_systemd_cgroup_controller=1//g' "$dd" 2>/dev/null || true
    done
    if ! grub_ok; then
      echo "donlab: couldn't update the GRUB config (need sudo?). Run these, then re-run ./donlab:"
      echo "        sudo sed -i -E 's/systemd\\.unified_cgroup_hierarchy=[^\" ]*//g; s/systemd\\.legacy_systemd_cgroup_controller=[^\" ]*//g' /etc/default/grub"
      echo "        sudo sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=\"/GRUB_CMDLINE_LINUX_DEFAULT=\"systemd.unified_cgroup_hierarchy=1 /' /etc/default/grub"
      echo "        sudo update-grub && sudo reboot"
      return 0
    fi
    $SUDO update-grub >/dev/null 2>&1 \
      || $SUDO grub-mkconfig  -o /boot/grub/grub.cfg  >/dev/null 2>&1 \
      || $SUDO grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || true
    echo "donlab: set cgroup v2 in GRUB and removed the v1 pin. Rebooting once; re-run ./donlab after."
  fi
  mkdir -p "$(dirname "$marker")" 2>/dev/null && : > "$marker" 2>/dev/null || true
  sync
  $SUDO reboot 2>/dev/null || echo "donlab: please reboot the appliance, then re-run ./donlab."
  exit 0
}

# ---- make sure the lab helpers (tmux + vim) are present ----------------------------------
# tmux: without it the framework opens a pop-up terminal per container, and on this appliance one
# can grab the whole X display (a black full-screen console); tmux keeps every host in one window.
# vim: the editor the manuals assume -- the appliance ships vi (vim-tiny) only, so install vim
# proper. Install whatever is missing in one apt transaction; non-fatal (tmux missing -> pop-ups,
# vim missing -> vi). Honors --no-tmux for tmux; vim is installed regardless.
ensure_tools() {
  local want=() p SUDO=""
  command -v tmux >/dev/null 2>&1 || { [ "${USE_TMUX:-1}" = 1 ] && want+=(tmux); }
  command -v vim  >/dev/null 2>&1 || want+=(vim)
  [ ${#want[@]} -gt 0 ] || return 0
  command -v apt-get >/dev/null 2>&1 || return 0       # only know how to install on Debian/Ubuntu
  if [ "$(id -u)" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then SUDO="sudo -n"; else
      echo "donlab: these lab helpers aren't installed: ${want[*]}. Install them once for the best"
      echo "        experience (tmux = clean multi-pane layout, vim = the manual's editor):"
      echo "        sudo apt-get install -y ${want[*]}"
      return 0
    fi
  fi
  run_step "Installing lab helpers (${want[*]})" \
    bash -c "$SUDO apt-get update -qq >/dev/null 2>&1; $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ${want[*]} >/dev/null 2>&1" || true
  for p in "${want[@]}"; do command -v "$p" >/dev/null 2>&1 || echo "donlab: could not install $p."; done
}

# ---- update the Labtainers FRAMEWORK via its official updater (donlab --update-labtainers) ----
# Best first step on an older appliance: pulls the latest Labtainers release (which repopulates
# labs/ and ships the newest framework fixes). Non-interactive; runs the NPS updater as-is.
update_labtainers() {
  local u
  for u in "$LTDIR/setup_scripts/update-labtainer.sh" \
           "$LTDIR/../setup_scripts/update-labtainer.sh" \
           "$LTDIR/trunk/setup_scripts/update-labtainer.sh"; do
    if [ -f "$u" ]; then
      step "Updating the Labtainers framework via its official updater:"
      echo "    $u"
      echo "    (downloads the latest Labtainers release + baseline images -- can take a few minutes)"
      ( cd "${LS_DIR:-$LTDIR}" 2>/dev/null || cd "$LTDIR" || exit 1; bash "$u" )
      local rc=$?
      if [ "$rc" -eq 0 ]; then step "Labtainers updated. Now run:  ./donlab <lab>"
      else step "Labtainers updater exited with status $rc (see output above)."; fi
      return "$rc"
    fi
  done
  step "Could not find setup_scripts/update-labtainer.sh under $LTDIR -- update Labtainers manually."
  return 1
}

# ============================================================================
# Self-update (runs FIRST, before anything else). Pulls the latest *keyless*
# donlab published in the imodule repo, grafts THIS machine's local key onto it,
# and swaps itself in -- atomically, and only after a checksum + sanity check.
# The key is never uploaded and never leaves this file; the published version has
# no key. SELF-HEALING: any failure (offline, bad checksum, unwritable, etc.) is
# swallowed and donlab carries on with the copy already on disk.
# ============================================================================
# self_update [force] -- fetch the published donlab, graft our local key+channel, replace in
# place, and re-exec. Called quietly on every run; `donlab -u/--update` calls it with `force`,
# which is VERBOSE (says what it's doing / why it didn't update) and bypasses the opt-out.
# FRESHNESS: raw.githubusercontent.com branch URLs sit behind a 5-minute CDN cache that IGNORES
# query strings, so right after a publish a stale copy (and a stale-but-matching .sha256) makes
# the update silently no-op. So we resolve the branch HEAD through the GitHub API (not CDN
# cached) and fetch by commit sha -- immutable, always exact -- falling back to the branch URL
# only if the API is unreachable.
self_update() {
  local force=""; [ "${1:-}" = force ] && { force=1; shift; }
  [ -z "$force" ] && [ -n "${DONLAB_NOSELFUPDATE:-}" ] && return 0   # opt-out / re-exec guard
  if ! command -v curl >/dev/null 2>&1; then
    [ -n "$force" ] && echo "donlab --update: curl is required but not installed."; return 0
  fi
  local self dir want got ref src at
  self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")" || return 0
  if [ ! -f "$self" ] || [ ! -w "$self" ]; then                 # can't rewrite -> skip, keep going
    [ -n "$force" ] && echo "donlab --update: $self is not writable. Re-run with sudo, or copy donlab into your home dir first."
    return 0
  fi
  dir="$(mktemp -d 2>/dev/null)" || return 0
  # branch HEAD commit via the API (fresh), then fetch at that sha (immutable); else branch URL
  ref="$(curl -fsSL --max-time 10 -H 'Accept: application/vnd.github+json' \
          "https://api.github.com/repos/$DON_REPO/commits/$DON_BRANCH" 2>/dev/null \
        | grep -m1 -oE '"sha": *"[0-9a-f]{40}"' | grep -oE '[0-9a-f]{40}' || true)"
  if [ -n "$ref" ]; then
    src="https://raw.githubusercontent.com/$DON_REPO/$ref/donlab"; at="@${ref:0:7}"
  else
    src="$DONLAB_URL"; at="(branch tip; may lag a few minutes)"
  fi
  [ -n "$force" ] && step "Checking the $DON_BRANCH channel for a newer donlab $at..."
  if curl -fsSL --max-time 20 "$src" -o "$dir/new" 2>/dev/null \
     && curl -fsSL --max-time 20 "$src.sha256" -o "$dir/sha" 2>/dev/null; then
    want="$(tr -d '[:space:]' < "$dir/sha" 2>/dev/null)"
    got="$(sha256sum "$dir/new" 2>/dev/null | awk '{print $1}')"
    # adopt only a complete, authentic, well-formed donlab
    if [ -n "$want" ] && [ "$want" = "$got" ] \
       && head -1 "$dir/new" | grep -q '^#!/bin/bash' \
       && grep -q '# DONLAB-KEY$' "$dir/new" \
       && grep -q '^# DONLAB-END$' "$dir/new"; then
      # graft our in-memory local key AND local channel onto the freshly fetched logic, so both
      # persist across self-updates (the published donlab ships keyless + CHANNEL='prod').
      awk -v k="$KEYB64" '/# DONLAB-KEY$/{print "KEYB64='\''" k "'\''   # DONLAB-KEY"; next} {print}' "$dir/new" > "$dir/m1" 2>/dev/null
      awk -v c="$CHANNEL" '/# DONLAB-CHANNEL$/{print "CHANNEL='\''" c "'\''   # DONLAB-CHANNEL"; next} {print}' "$dir/m1" > "$dir/merged" 2>/dev/null
      if [ -s "$dir/merged" ] && grep -q '^# DONLAB-END$' "$dir/merged" && ! cmp -s "$dir/merged" "$self"; then
        # atomic replace (temp in the same dir as self, then rename)
        if cp "$dir/merged" "$self.tmp.$$" 2>/dev/null && chmod +x "$self.tmp.$$" 2>/dev/null && mv -f "$self.tmp.$$" "$self" 2>/dev/null; then
          [ -n "$force" ] && step "Fetched a newer donlab; applying and re-launching..."
          rm -rf "$dir"
          # re-run the updated logic once; DONLAB_UPDATED lets the -u handler confirm the new version
          exec env DONLAB_NOSELFUPDATE=1 DONLAB_UPDATED=1 bash "$self" "$@"
        fi
        rm -f "$self.tmp.$$" 2>/dev/null
        [ -n "$force" ] && echo "donlab --update: could not write the new donlab in place."
      elif [ -n "$force" ]; then
        : # already current; the -u handler prints the version
      fi
    elif [ -n "$force" ]; then
      echo "donlab --update: the downloaded donlab failed validation (checksum/format); not applied."
    fi
  elif [ -n "$force" ]; then
    echo "donlab --update: could not download from $DONLAB_URL (network / proxy?)."
  fi
  rm -rf "$dir" 2>/dev/null
  return 0
}
self_update "$@" || true

# ---- user-invoked forced update: donlab -u / --update (cache-busted, verbose) ----
# On a real update, self_update above re-execs us with DONLAB_UPDATED=1; on re-entry we just
# confirm the new version. Otherwise we force a cache-busted check and report the outcome.
for _a in "$@"; do case "$_a" in
  -u|--update)
    if [ -n "${DONLAB_UPDATED:-}" ]; then
      echo "donlab is now at $DONLAB_VERSION (channel: $CHANNEL)."; exit 0
    fi
    self_update force
    # reaching here means no newer copy was applied
    echo "donlab is already up to date ($DONLAB_VERSION, channel: $CHANNEL)."
    exit 0 ;;
esac; done

# ---- args: pull out our flags, pass the rest through to labtainer ----
USE_TMUX=1
UPDATE_LT=0
PASS=()
for a in "$@"; do
  case "$a" in
    --no-tmux|--gui) USE_TMUX=0 ;;
    --tmux)          USE_TMUX=1 ;;
    --update-labtainers|--update-framework|--update-lt) UPDATE_LT=1 ;;
    *)               PASS+=("$a") ;;
  esac
done
if [ "$UPDATE_LT" != 1 ]; then
  [ ${#PASS[@]} -ge 1 ] || { echo "usage: donlab <labname> [--no-tmux] [labtainer args...]"; \
    echo "       donlab -u|--update            # force-update donlab itself (cache-busted)"; \
    echo "       donlab --update-labtainers    # update the Labtainers framework itself, then re-run"; \
    echo "       donlab -v|--version           # print the donlab version"; exit 1; }
  LAB="${PASS[0]}"
fi

# ---- preflight: the things every lab needs ----
command -v docker >/dev/null 2>&1 || { echo "donlab: docker is not installed or not on your PATH."; exit 1; }
if ! docker ps >/dev/null 2>&1; then
  echo "donlab: can't talk to the Docker daemon. Is it running? Are you in the 'docker' group?"
  echo "        try:  sudo systemctl start docker    (and log out/in if you were just added to the group)"
  exit 1
fi

# Convert a legacy cgroup v1 host to v2 before doing any lab work (reboots once if needed).
ensure_cgroup2

# ---- locate labtainer and its tree (SELF-HEALING) ----
# A student never has to configure anything: try PATH, then $LABTAINER_DIR, then the known
# appliance/install locations, then a bounded search under $HOME. So a fresh box with no env
# set up still works on a bare `./donlab <lab>`.
find_labtainer() {
  local c
  c="$(command -v labtainer 2>/dev/null)" && [ -x "$c" ] && { echo "$c"; return 0; }
  for c in       "${LABTAINER_DIR:-}/scripts/labtainer-student/bin/labtainer"       "$HOME/labtainer/scripts/labtainer-student/bin/labtainer"       "$HOME/labtainer/trunk/scripts/labtainer-student/bin/labtainer"       "$HOME/Labtainers/scripts/labtainer-student/bin/labtainer"       /home/*/labtainer/scripts/labtainer-student/bin/labtainer       /home/*/labtainer/trunk/scripts/labtainer-student/bin/labtainer       /opt/labtainer/scripts/labtainer-student/bin/labtainer; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  c="$(find "$HOME" -maxdepth 6 -type f -path '*/scripts/labtainer-student/bin/labtainer' 2>/dev/null | head -1)"
  [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  return 1
}
# A real Labtainers tree carries these two, and the framework keys off exactly them:
# start.py fatally opens $LABTAINER_DIR/README.md, and the `labtainer` wrapper execs a
# RELATIVE bin/start.py from scripts/labtainer-student. (labs/ is created below, so it is
# NOT part of the signature -- a fresh appliance may not have it yet.)
is_lt_tree() { [ -n "$1" ] && [ -f "$1/README.md" ] && [ -d "$1/scripts/labtainer-student" ]; }

# ---- resolve the Labtainers tree ($LTDIR), grounded in the framework's own contract ----
# ORDER MATTERS. The stock appliance already exports a CORRECT $LABTAINER_DIR (that is why
# `labtainer` works when you run it by hand); donlab must TRUST it, never clobber it with a
# path guessed from where the binary happens to sit. Only when the env is unset or does not
# point at a real tree do we go looking -- and anything we derive is validated with
# is_lt_tree before we accept it, so a PATH shim or an odd layout can't hand us /home/student.
LTDIR=""; LT=""
if [ -n "${LABTAINER_DIR:-}" ] && is_lt_tree "$LABTAINER_DIR"; then
  LTDIR="$(cd "$LABTAINER_DIR" 2>/dev/null && pwd -P || true)"
fi
if [ -z "$LTDIR" ]; then
  LT="$(find_labtainer || true)"
  if [ -n "$LT" ] && [ -x "$LT" ]; then
    d="$(cd "$(dirname "$LT")" 2>/dev/null && pwd -P || true)"
    # strip the known .../scripts/labtainer-student/bin suffix, else start from the bin dir,
    # then walk upward until we hit a directory that actually IS a Labtainers tree.
    case "$d" in
      */scripts/labtainer-student/bin) cand="${d%/scripts/labtainer-student/bin}" ;;
      *) cand="$d" ;;
    esac
    if is_lt_tree "$cand"; then
      LTDIR="$cand"
    else
      p="$d"
      while [ -n "$p" ] && [ "$p" != "/" ]; do
        if is_lt_tree "$p"; then LTDIR="$p"; break; fi
        p="$(dirname "$p")"
      done
    fi
  fi
fi
if [ -z "$LTDIR" ]; then
  for cand in "$HOME/labtainer" "$HOME/labtainer/trunk" "$HOME/Labtainers" \
              /opt/labtainer /home/*/labtainer /home/*/labtainer/trunk; do
    if is_lt_tree "$cand"; then LTDIR="$(cd "$cand" 2>/dev/null && pwd -P || true)"; [ -n "$LTDIR" ] && break; fi
  done
fi
if [ -z "$LTDIR" ]; then
  echo "donlab: could not find a valid Labtainers install."
  echo "        A valid tree has README.md and scripts/labtainer-student/ at its root."
  echo "        Looked at \$LABTAINER_DIR, PATH, ~/labtainer[/trunk], ~/Labtainers,"
  echo "        /home/*/labtainer and /opt/labtainer. If it lives elsewhere, set"
  echo "        LABTAINER_DIR to that directory and re-run ./donlab."
  exit 1
fi

# ---- orientation: export the validated tree and ensure labs/ exists. The `labtainer`
# wrapper execs a RELATIVE bin/start.py, so donlab also auto-cds into scripts/labtainer-student
# below -- a wrong working directory (e.g. the student's home) can't make the lab fail. ----
export LABTAINER_DIR="$LTDIR"
# The `labtainer` binary we invoke is ALWAYS the one inside the validated tree, whichever way
# the tree was found (a trusted env sets no $LT; a PATH shim could point elsewhere).
LT="$LTDIR/scripts/labtainer-student/bin/labtainer"
[ -x "$LT" ] || { echo "donlab: $LT is missing or not executable -- is this a complete Labtainers install?"; exit 1; }
# A fresh appliance may not have the labs dir yet, and imodule/labtainer must target
# $LABTAINER_DIR/labs (NOT ~/labs). Ensure it exists; never assume a specific $HOME/user.
mkdir -p "$LTDIR/labs" 2>/dev/null || true

# framework-update mode: `donlab --update-labtainers` -- do it and exit (needs $LTDIR/$LS_DIR).
if [ "$UPDATE_LT" = 1 ]; then update_labtainers; exit $?; fi
LS_DIR="$LTDIR/scripts/labtainer-student"
if [ -d "$LS_DIR" ]; then
  if [ "$(pwd -P 2>/dev/null)" != "$(cd "$LS_DIR" 2>/dev/null && pwd -P)" ]; then
    cd "$LS_DIR" || { echo "donlab: could not cd to $LS_DIR"; exit 1; }
    echo "donlab: oriented to \$LABTAINER_DIR=$LTDIR (working from scripts/labtainer-student)"
  fi
fi


SHIM=""
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"; [ -n "$SHIM" ] && rm -rf "$SHIM"' EXIT

# ---- fetch / refresh the encrypted lab bundle (imodule) ----
CFG="$HOME/.config/don-range"; mkdir -p "$CFG"; chmod 700 "$CFG" 2>/dev/null || true
step "Checking for the latest lab bundle..."
remote_sha="$(curl -fsSL "$IMODULE_URL.sha256" 2>/dev/null | tr -d '[:space:]' || true)"
local_sha="$(cat "$CFG/installed.sha256" 2>/dev/null || true)"
if [ -z "$remote_sha" ] || [ "$remote_sha" != "$local_sha" ]; then
  step "Downloading the lab bundle (this can take a minute)..."
  if { if _is_tty; then curl -fL --progress-bar "$IMODULE_URL" -o "$TMP/e"; else curl -fsSL "$IMODULE_URL" -o "$TMP/e"; fi; }; then
    if [ -z "$remote_sha" ] || [ "$(sha256sum "$TMP/e" | awk '{print $1}')" = "$remote_sha" ]; then
      printf '%s' "$KEYB64" | base64 -d > "$TMP/k"; chmod 600 "$TMP/k"
      if openssl enc -d -aes-256-cbc -pbkdf2 -pass file:"$TMP/k" -in "$TMP/e" -out "$TMP/imodule.tar" 2>/dev/null; then
        IMOD="$(command -v imodule || echo "${LABTAINER_DIR:-}/scripts/labtainer-student/bin/imodule")"
        # Older appliance releases of imodule open ~/.local/share/labtainers/imodules.txt for
        # append WITHOUT creating the directory (FileNotFoundError on a fresh box). Pre-create it.
        mkdir -p "$HOME/.local/share/labtainers" 2>/dev/null || true
        if [ -x "$IMOD" ] && run_step "Installing labs" "$IMOD" "file://$TMP/imodule.tar"; then
          [ -n "$remote_sha" ] && printf '%s' "$remote_sha" > "$CFG/installed.sha256"
          step "Lab bundle installed."
        else echo "WARN: imodule install failed; using installed version."; fi
      else echo "WARN: decrypt failed; using installed version."; fi
    else echo "WARN: checksum mismatch; using installed version."; fi
  else echo "WARN: could not fetch imodule; using installed version."; fi
else
  step "Lab bundle is already up to date."
fi

# ---- prune stale per-container files left by a container RENAME ----
# The imodule install merges into the lab dir, so if a lab's containers were renamed
# (e.g. fileserver -> hi-fs01), the OLD dockerfiles / dirs linger next to the new ones
# and the framework trips ("KeyError"). Remove any dockerfile/dir whose container is no
# longer a CONTAINER in start.config.
prune_stale() {
  local sc="$LTDIR/labs/$LAB/config/start.config" df c
  [ -f "$sc" ] || return 0
  local conts; conts="$(awk '/^[[:space:]]*CONTAINER[[:space:]]/{print $2}' "$sc")"
  [ -n "$conts" ] || return 0
  for df in "$LTDIR/labs/$LAB/dockerfiles/Dockerfile.$LAB."*.student; do
    [ -e "$df" ] || continue
    c="$(basename "$df")"; c="${c#Dockerfile.$LAB.}"; c="${c%.student}"
    if ! printf '%s\n' "$conts" | grep -qx "$c"; then
      rm -f "$df"; rm -rf "$LTDIR/labs/$LAB/$c"
    fi
  done
  # Labtainers reuses a cached parameterized copy at scripts/labtainer-student/.tmp/<lab>/
  # start.config if present. If it is stale, start.py uses the OLD container list: a REMOVED
  # container crashes start.py (KeyError), and an ADDED one (e.g. hi-dc01 gained by a lab update)
  # is silently skipped -- the lab comes up N-1 containers with no error (seen on the VPS). Drop
  # the cache whenever its container SET differs from the real one, in EITHER direction.
  local lsdir tmpsc tmpconts realconts
  lsdir="$(cd "$(dirname "$LT")/.." 2>/dev/null && pwd || true)"
  tmpsc="$lsdir/.tmp/$LAB/start.config"
  if [ -n "$lsdir" ] && [ -f "$tmpsc" ]; then
    tmpconts="$(awk '/^[[:space:]]*CONTAINER[[:space:]]/{print $2}' "$tmpsc" | sort)"
    realconts="$(printf '%s\n' "$conts" | sort)"
    [ "$tmpconts" = "$realconts" ] || rm -rf "$lsdir/.tmp/$LAB"
  fi
}
prune_stale

# ---- lab manual bridge: serve the manual over http://127.0.0.1 so its Check Work / Stop Lab /
# scenario buttons can reach the local API (a file:// page has no origin to call). The bridge is
# embedded here (base64) and written out on demand; its static root is ONLY the lab's docs dir,
# so config/ and instr_config/ (grading logic) are never served. ----
BRIDGE_PORT="${DONLAB_BRIDGE_PORT:-5173}"
BRIDGE_B64=''
write_bridge() {
  mkdir -p "$CFG" 2>/dev/null || return 1
  printf '%s' "$BRIDGE_B64" | base64 -d > "$CFG/lab-bridge.py" 2>/dev/null
  [ -s "$CFG/lab-bridge.py" ]
}
start_bridge() {   # start (or restart, pointed at THIS lab) the manual bridge; 0 if it answers
  command -v python3 >/dev/null 2>&1 || return 1
  command -v curl    >/dev/null 2>&1 || return 1
  [ -f "$LTDIR/labs/$LAB/docs/$LAB.html" ] || return 1
  write_bridge || return 1
  pkill -f "$CFG/lab-bridge.py" 2>/dev/null; sleep 0.3
  LABTAINER_DIR="$LTDIR" PREVIEW_DIR="$LTDIR/labs/$LAB/docs" PORT="$BRIDGE_PORT" \
    setsid python3 "$CFG/lab-bridge.py" >"$CFG/lab-bridge.out" 2>&1 </dev/null &
  local i
  for i in 1 2 3 4 5 6; do
    curl -fsS -m2 "http://127.0.0.1:$BRIDGE_PORT/api/ping" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  return 1
}
# ---- open the lab manual (prefer the bridge -> live buttons; fall back to file://) ----
open_manual() {
  [ -n "${DISPLAY:-}" ] || return 0
  local url b m="$LTDIR/labs/$LAB/docs/$LAB.html"
  if start_bridge; then
    url="http://127.0.0.1:$BRIDGE_PORT/$LAB.html"
    echo "donlab: manual + live Check Work / Stop Lab at $url"
  else
    [ -f "$m" ] || return 0
    url="file://$m"
    echo "donlab: manual opened read-only (bridge unavailable; the live buttons need it)"
  fi
  for b in firefox firefox-esr x-www-browser xdg-open; do
    if command -v "$b" >/dev/null 2>&1; then ("$b" "$url" >/dev/null 2>&1 &) ; return 0; fi
  done
}

# ---- lay a started lab out in one tmux session (embedded launcher) ----
lab_tmux() {
  local SC="$LTDIR/labs/$LAB/config/start.config"
  [ -f "$SC" ] || { echo "no start.config for '$LAB' -- terminals not laid out."; return 1; }
  command -v tmux >/dev/null 2>&1 || return 1
  local SESSION="lab-$LAB"
  tmux kill-session -t "$SESSION" 2>/dev/null || true
  local running; running=$(docker ps --format '{{.Names}}')
  local made=0 cur="" idx=0 key val junk c n full cmd p
  declare -A TERMS ORDER
  while read -r key val junk; do
    case "$key" in
      CONTAINER) cur="$val"; TERMS[$cur]=1; ORDER[$cur]=$((idx++)) ;;
      TERMINALS) [ -n "$cur" ] && TERMS[$cur]="$val" ;;
    esac
  done < "$SC"
  for c in $(for k in "${!ORDER[@]}"; do echo "${ORDER[$k]} $k"; done | sort -n | awk '{print $2}'); do
    n="${TERMS[$c]}"; [ "$n" = "0" ] && continue; [ "$n" = "-1" ] && continue   # hidden host
    full="$LAB.$c.student"
    grep -qx "$full" <<<"$running" || continue                                    # not running
    cmd="docker exec -it $full bash -l"
    if [ "$made" = 0 ]; then tmux new-session -d -s "$SESSION" -n "$c" "$cmd"
    else                     tmux new-window  -t "$SESSION"    -n "$c" "$cmd"; fi
    for ((p=1; p<n; p++)); do
      tmux split-window -t "$SESSION:$c" "$cmd"
      tmux select-layout -t "$SESSION:$c" tiled >/dev/null
    done
    made=$((made+1))
  done
  [ "$made" -gt 0 ] || { echo "no visible terminals for '$LAB' -- is it running?"; return 1; }
  tmux set -t "$SESSION" mouse on >/dev/null 2>&1 || true
  tmux set -t "$SESSION" pane-border-status top >/dev/null 2>&1 || true
  # Force a dark-blue status line + readable tabs and subtle borders, scoped to THIS
  # session, so our tmux looks right regardless of the host VM's theme. (Pane contents are
  # the terminal emulator's own colors; this styles tmux's chrome.)
  tmux set -t "$SESSION" status-style "bg=#00337a,fg=#dceafc" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" status-left-style "fg=#ffffff,bold" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" status-right-style "fg=#bcd6f5" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" window-status-current-style "bg=#0a58b0,fg=#ffffff,bold" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" window-status-style "fg=#cfe0f7" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" message-style "bg=#00337a,fg=#ffffff" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" pane-border-style "fg=#274056" >/dev/null 2>&1 || true
  tmux set -t "$SESSION" pane-active-border-style "fg=#5aa9d6" >/dev/null 2>&1 || true
  # Make pane splits open a shell INSIDE the current window's host (a docker exec into
  # that container), not a plain shell on the Labtainer host. The host is read live from
  # the active window's name at split time. Bindings are server-wide; donlab (re)sets them
  # for the current lab on each launch.
  tmux bind-key '%'  run-shell "H=\$(tmux display -p '#{window_name}'); tmux split-window -h \"docker exec -it $LAB.\$H.student bash -l\"" 2>/dev/null || true
  tmux bind-key '"'  run-shell "H=\$(tmux display -p '#{window_name}'); tmux split-window -v \"docker exec -it $LAB.\$H.student bash -l\"" 2>/dev/null || true
  tmux select-window -t "$SESSION":0 >/dev/null 2>&1 || true
  echo "tmux '$SESSION': Ctrl-b n/p = next/prev host, Ctrl-b w = pick a host,"
  echo "                 Ctrl-b % or \" = split into panes, Ctrl-b d = detach (lab keeps running)."
  if [ -t 0 ] && [ -t 1 ]; then
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "$SESSION"; else exec tmux attach -t "$SESSION"; fi
  else
    echo "not a terminal -- attach with: tmux attach -t $SESSION"
  fi
}

# ---- start the lab, self-healing a common failure: a leftover Docker network (or a
#      not-fully-stopped previous lab) with an overlapping subnet blocks the start, so no
#      containers come up. Detect the framework's cleanup hint, clear it, and retry once. ----
LT_LOG="$TMP/labtainer.log"
lab_running() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qE "^$LAB\.[^.]*\.student$"; }
run_lab() {   # $1 = optional PATH prefix (the tmux gnome-terminal shim)
  if [ -n "${1:-}" ]; then PYTHONUNBUFFERED=1 PATH="$1:$PATH" "$LT" "${PASS[@]}" 2>&1 | tee "$LT_LOG"
  else                     PYTHONUNBUFFERED=1                "$LT" "${PASS[@]}" 2>&1 | tee "$LT_LOG"; fi
}
start_lab() {  # $1 = optional PATH prefix
  step "Starting $LAB -- the FIRST launch builds/pulls this lab's container images and can take"
  echo "    several minutes. It is working even when quiet; live output follows."
  run_lab "${1:-}"
  lab_running && return 0
  local nets stale n l
  nets=$(grep -oE 'network rm [A-Za-z0-9_.-]+' "$LT_LOG" 2>/dev/null | awk '{print $NF}' | sort -u)
  stale=$(grep -oE "stop the lab \['[^']+'\]" "$LT_LOG" 2>/dev/null | grep -oE "'[^']+'" | tr -d "'" | sort -u)
  if [ -n "$nets$stale" ]; then
    for l in $stale; do echo "donlab: stopping a leftover lab ('$l') that was blocking the start"; "$(dirname "$LT")/stoplab" "$l" >/dev/null 2>&1 || true; done
    for n in $nets;  do echo "donlab: clearing a leftover network ('$n') that was blocking the start"; docker network rm "$n" >/dev/null 2>&1 || true; done
    run_lab "${1:-}"
  fi
  if ! lab_running; then
    echo "donlab: the lab did not start -- see the messages above (try: stoplab $LAB, then run donlab again)."
    show_dead_containers
  fi
}
# After a failed start, show which of this lab's containers are NOT up and the tail of each
# one's log -- a container that died right after launch is otherwise invisible to the student.
show_dead_containers() {
  local line name status
  docker ps -a --format '{{.Names}}\t{{.Status}}' 2>/dev/null | grep -E "^$LAB\.[^.]*\.student\b" \
  | while IFS=$'\t' read -r name status; do
      case "$status" in Up*) continue ;; esac
      echo "donlab: container $name is not running ($status). Last log lines:"
      docker logs --tail 15 "$name" 2>&1 | sed 's/^/    | /'
    done
}

# Install the lab helpers (tmux for the multi-pane layout, vim as the manual's editor) if missing.
ensure_tools

# ---- standard (pop-up terminals) mode ----
# Start the lab FIRST; open the manual only once the containers are actually up, so it does
# not pop over the terminal while Docker is still pulling and starting things.
if [ "$USE_TMUX" = 0 ] || ! command -v tmux >/dev/null 2>&1; then
  [ "$USE_TMUX" = 1 ] && echo "tmux not found; using standard pop-up terminals."
  start_lab ""
  if lab_running; then open_manual; fi
  exit 0
fi

# ---- tmux mode: suppress the pop-up terminals, start the lab, then lay it out ----
SHIM="$(mktemp -d)"
printf '#!/bin/sh\nexit 0\n' > "$SHIM/gnome-terminal"
cp "$SHIM/gnome-terminal" "$SHIM/xterm"
chmod +x "$SHIM/gnome-terminal" "$SHIM/xterm"
start_lab "$SHIM"
# Only open the manual / lay out tmux if the lab actually came up; start_lab already explained
# any failure (and listed any container that died).
if lab_running; then open_manual; lab_tmux; fi
# DONLAB-END
